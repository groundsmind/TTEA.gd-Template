[gd_scene format=3 uid="uid://cn67gecooprai"]

[sub_resource type="GDScript" id="GDScript_lti8b"]
resource_name = "wawa"
script/source = "extends Node2D

@onready var label: Label = $Label


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	label.text = str(Server.data)
"

[sub_resource type="GDScript" id="GDScript_vsb4k"]
resource_name = "MenuButtons"
script/source = "extends HBoxContainer

@onready var calibrate: Button = $calibrate

func _ready() -> void:
	Server.data_received.connect(_on_server_data_received)

func _on_start_toggled(_toggled_on: bool) -> void:
	pass # Replace with function body.

func _on_calibrate_pressed() -> void:
	Server.send_data(\"CAL\")
	calibrate.disabled = true

func _on_exit_pressed() -> void:
	Server.send_data(\"EXT\")
	get_tree().quit()

func _on_server_data_received(data) -> void:
	print(data)
	if data is String and data == \"CAL_OK\":
		calibrate.disabled = false
"


[sub_resource type="GDScript" id="GDScript_lti8b"]
resource_name = "wawa"
script/source = "extends Node2D

@onready var label: Label = $Label


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	label.text = str(Server.data)
"

[sub_resource type="GDScript" id="GDScript_vsb4k"]
resource_name = "MenuButtons"
script/source = "extends HBoxContainer

@onready var calibrate: Button = $calibrate

func _on_calibrate_pressed() -> void:
	calibrate.disabled = true
	get_tree().change_scene_to_file(\"res://calibrate.tscn\")

func _on_exit_pressed() -> void:
	Server.send_data(\"EXT\")
	Server.stop()
"

[sub_resource type="GDScript" id="GDScript_g4v7s"]
script/source = "extends Sprite2D

func _process(_delta: float) -> void:
	rotate(0.01)
"

